{
  "name": "koota",
  "version": "0.6.6",
  "description": "🌎 Performant real-time state management for TypeScript, React and Svelte",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmndrs/koota"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "import": "./src/react.ts"
    },
    "./svelte": {
      "types": "./src/svelte.ts",
      "svelte": "./src/svelte.ts",
      "default": "./src/svelte.ts"
    }
  },
  "files": [
    "dist",
    "react",
    "svelte",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./react": {
        "import": {
          "types": "./dist/react.d.ts",
          "default": "./dist/react.js"
        },
        "require": {
          "types": "./dist/react.d.cts",
          "default": "./dist/react.cjs"
        }
      },
      "./svelte": {
        "types": "./dist/svelte/index.d.ts",
        "svelte": "./dist/svelte/index.js",
        "default": "./dist/svelte/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && node --no-warnings scripts/build-svelte.ts && node --no-warnings scripts/copy-readme.ts",
    "test": "NODE_OPTIONS=--expose-gc vitest --config vitest-config.ts",
    "generate-tests": "node scripts/generate-tests.ts"
  },
  "devDependencies": {
    "@config/typescript": "workspace:*",
    "@koota/core": "workspace:*",
    "@koota/react": "workspace:*",
    "@koota/svelte": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/svelte": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tsdown": "^0.23.2",
    "typescript": "catalog:typescript6",
    "unplugin-inline-functions": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@types/react": "catalog:peers",
    "react": "catalog:peers",
    "svelte": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
