{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "license": "ISC",
  "prettier": "./.config/prettier/base.json",
  "scripts": {
    "bench": "node scripts/run-bench.mts",
    "build": "pnpm -F koota build",
    "examples": "tsx ./scripts/examples.ts",
    "release": "pnpm test:build && pnpm -F koota publish",
    "test": "pnpm -r --filter=!koota test",
    "test:build": "pnpm build && pnpm -F koota generate-tests && pnpm -F koota test run",
    "lint": "oxlint .",
    "format": "prettier --config .config/prettier/base.json --ignore-path .config/prettier/prettierignore --write .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './benches' --filter '!./packages/publish' exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
